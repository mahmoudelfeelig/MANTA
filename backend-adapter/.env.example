# Required auth token used by Android endpoints
ADAPTER_SHARED_TOKEN=replace-with-long-random-token

# Required, distinct token used by the operator dashboard and administrative APIs
ADAPTER_OPERATOR_TOKEN=replace-with-a-different-long-random-token

# Optional Wazuh forwarding endpoint. If empty, adapter stores accepted events locally.
WAZUH_INGEST_URL=
WAZUH_API_TOKEN=

# Optional Resistine manager endpoint. If empty, Resistine routes return 503.
RESISTINE_BASE_URL=
RESISTINE_API_TOKEN=

# Security defaults
ALLOW_INSECURE_WAZUH=false
ALLOW_INSECURE_RESISTINE=false
MAX_EVENT_SIZE_BYTES=65536
MAX_RETRIES=5
RETRY_BASE_SECONDS=5

# Local state
SQLITE_PATH=adapter_state.db
